<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <!-- ES CAMBIA L'HERÈNCIA: Ara s'hereta directament la vista d'albarans estàndard d'Odoo -->
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            
            <!-- Busquem el botó per imprimir etiqueta de devolució, que segueix existint a la vista estàndard -->
            <xpath expr="//button[@name='print_return_label']" position='after'>
                <button
                    name="packlink_pro_get_label"
                    string="Print PacklinkPRO Label"
                    type="object"
                    invisible="not carrier_tracking_ref or delivery_type != 'packlink_pro' or state != 'done'"
                />
            </xpath>

            <!-- A la vista estàndard de la v18, el grup de dades del transportista es diu 'carrier_data' o penja de la pestanya d'informació addicional -->
            <xpath expr="//group[@name='carrier_data']" position="inside">
                <field name="packlink_pro_service_selected_id" string="Service Selected ID"/>
                <field name="packlink_pro_service_selected" string="Service Selected"/>
                <field name="packlink_pro_length" readonly="1"/>
                <field name="packlink_pro_height" readonly="1"/>
                <field name="packlink_pro_width" readonly="1"/>
                <field name="packlink_pro_customs_required"/>
                <button
                    name="packlink_pro_get_customs"
                    string="Print PacklinkPRO Customs"
                    type="object"
                    invisible="not packlink_pro_customs_required or delivery_type != 'packlink_pro'"
                />
            </xpath>
        </field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="delivery.view_picking_withcarrier_out_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='print_return_label']/.." position='inside'>
                <button
                    name="packlink_pro_get_label"
                    string="Print PacklinkPRO Label"
                    type="object"
                    attrs="{'invisible':[
                        '|',
                        '|',
                        ('carrier_tracking_ref', '=', False),
                        ('delivery_type', '!=', 'packlink_pro'),
                        ('state', '!=', 'done')
                    ]}"
                />
            </xpath>
            <xpath expr="//group[@name='carrier_data']" position="inside">
                <field name="packlink_pro_service_selected_id" string="Service Selected ID"/>
                <field name="packlink_pro_service_selected" string="Service Selected"/>
                <field name="packlink_pro_length" attrs="{'readonly':True}"/>
                <field name="packlink_pro_height" attrs="{'readonly':True}"/>
                <field name="packlink_pro_width" attrs="{'readonly':True}"/>
                <field name="packlink_pro_customs_required"/>
                <button
                    name="packlink_pro_get_customs"
                    string="Print PacklinkPRO Customs"
                    type="object"
                    attrs="{'invisible':[
                        '|',
                        ('packlink_pro_customs_required', '=', False),
                        ('delivery_type', '!=', 'packlink_pro'),
                    ]}"
                />
            </xpath>
        </field>
    </record>
    <!--record id="view_stock_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.picking.view_stock_picking_form"/>
        <field name="arch" type="xml">
            <field name="carrier_tracking_ref" position="after">
                <field name="packlink_pro_reference"></field>
            </field>
        </field>
    </record-->
</odoo>

<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <page name="other_information" position="after">
                <page string="Packlink" name="packlink_sale" attrs="{'invisible':[('is_packlink_pro_delivery_type','!=',True)]}">
                    <group>
                        <group name="packlink_sale">
                            <field name="is_packlink_pro_delivery_type" invisible="1"/>
                            <field name="packlink_pro_service_selected_id" string="Service Selected ID"/>
                            <field name="packlink_pro_service_selected" string="Service Selected"/>
                            <field name="packlink_pro_customs_required"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>

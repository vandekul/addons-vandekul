<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="debranding_login_layout" inherit_id="web.login_layout" >
        <xpath expr="//t[@t-out='0']" position="after">
            <t t-set="disable_footer" t-value="True" />
        </xpath>
    </template>

    <template id="hidden_signup" inherit_id="auth_signup.signup">
        <xpath expr="//a[@role='button']" position="attributes">
            <attribute name="class" add="d-none" />
        </xpath>
    </template>
</odoo>
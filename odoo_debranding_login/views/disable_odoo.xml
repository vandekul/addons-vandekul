<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="debranding_login_layout" inherit_id="web.login_layout" >
        <xpath expr="//t[@t-out='0']" position="after">
            <t t-set="disable_footer" t-value="True" />
        </xpath>
    </template>

    <template id="hidden_signup" inherit_id="auth_signup.signup">
        <xpath expr="//div[@class='text-center oe_login_buttons d-grid pt-3']" position="replace">
            <div class="text-center oe_login_buttons d-grid pt-3">
                <button type="submit" class="btn btn-primary"> Sign up</button>
                <div class="o_login_auth"/>
            </div>
        </xpath>
    </template>
</odoo>
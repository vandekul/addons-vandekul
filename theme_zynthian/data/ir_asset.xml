<?xml version="1.0" encoding="utf-8"?>
<odoo>

<asset id="theme_zynthian.primary_variables_scss" name="Zynthian primary variables SCSS">
    <field name="key">theme_zynthian.primary_variables_scss</field>
    <bundle>web._assets_primary_variables</bundle>
    <path>theme_zynthian/static/src/scss/primary_variables.scss</path>
</asset>

<asset id="theme_zynthian.bootstrap_overridden_scss" name="Zynthian bootstrap overridden SCSS">
    <field name="key">theme_zynthian.bootstrap_overridden_scss</field>
    <bundle directive="prepend">web._assets_frontend_helpers</bundle>
    <path>theme_zynthian/static/src/scss/bootstrap_overridden.scss</path>
</asset>

<asset id="theme_zynthian.theme_scss" name="Zynthian theme SCSS">
    <field name="key">theme_zynthian.theme_scss</field>
    <bundle>web.assets_frontend</bundle>
    <path>theme_zynthian/static/src/scss/theme.scss</path>
</asset>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ======== COVER (zynthian.org home banner) ======== -->
<template id="s_cover" inherit_id="website.s_cover" name="Zynthian s_cover">
    <xpath expr="section" position="attributes">
        <attribute name="class" add="o_zyn_hero" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_we_bg_filter')]" position="attributes">
        <attribute name="class">o_we_bg_filter bg-black-75</attribute>
    </xpath>
    <xpath expr="//h1" position="before">
        <h6 class="o_zyn_kicker" style="text-align: center;">The open music instrument</h6>
    </xpath>
    <xpath expr="//h1" position="attributes">
        <attribute name="class" add="display-3" separator=" "/>
    </xpath>
    <xpath expr="//h1" position="replace" mode="inner">
        Zynthian
    </xpath>
    <xpath expr="//p[hasclass('lead')]" position="replace" mode="inner">
        A compact, self-contained, music-making device: keyboard expander, audio effects unit,<br/> MIDI processor &amp; router, groovebox and micro-DAW.
    </xpath>
    <xpath expr="//a[hasclass('btn')]/t" position="replace" mode="inner">
        Get your KIT
    </xpath>
    <xpath expr="(//a[hasclass('btn')])[1]" position="attributes">
        <attribute name="t-att-href"/>
        <attribute name="href">/shop</attribute>
    </xpath>
    <!-- Odoo 16 s_cover has a single button: add the "Community" one -->
    <xpath expr="(//a[hasclass('btn')])[1]" position="after">
        <a href="https://discourse.zynthian.org" class="btn btn-outline-secondary mb-2 ms-2">Community</a>
    </xpath>
</template>

<!-- ======== TITLE ======== -->
<template id="s_title" inherit_id="website.s_title" name="Zynthian s_title">
    <xpath expr="//h1" position="replace" mode="inner">
        Zynthian Shop
    </xpath>
</template>

<!-- ======== TEXT - IMAGE ======== -->
<template id="s_text_image" inherit_id="website.s_text_image" name="Zynthian s_text_image">
    <xpath expr="//h2" position="before">
        <h6 class="o_zyn_kicker">Concept</h6>
    </xpath>
    <xpath expr="//h2" position="replace" mode="inner">
        A new kind of musical instrument
    </xpath>
    <xpath expr="//p[1]" position="replace" mode="inner">
        Zynthian is a community-driven project: 100% open-source, featuring free software running on open hardware. It is completely configurable and fully hackable! <strong>Free as in Freedom</strong>.
    </xpath>
    <xpath expr="//p[2]" position="replace" mode="inner">
        You can build your Zynthian from scratch or buy an official kit.
    </xpath>
    <xpath expr="//a[hasclass('btn')]" position="attributes">
        <attribute name="class">btn btn-primary</attribute>
        <attribute name="href">/shop</attribute>
    </xpath>
    <xpath expr="//a[hasclass('btn')]" position="replace" mode="inner">
        Shop now
    </xpath>
</template>

<!-- ======== THREE COLUMNS (use cases) ======== -->
<template id="s_three_columns" inherit_id="website.s_three_columns" name="Zynthian s_three_columns">
    <xpath expr="(//h3[hasclass('card-title')])[1]" position="replace" mode="inner">Keyboard expander</xpath>
    <xpath expr="(//p[hasclass('card-text')])[1]" position="replace" mode="inner">
        Over 100 virtual instruments: acoustic and electric keys, organs, iconic and virtual analog synthesizers, and sample-based instruments.
    </xpath>
    <xpath expr="(//h3[hasclass('card-title')])[2]" position="replace" mode="inner">Audio effects unit</xpath>
    <xpath expr="(//p[hasclass('card-text')])[2]" position="replace" mode="inner">
        Over 1,000 audio effects &amp; MIDI tools: classic and modern effects, neural network amp modeling and impulse responses.
    </xpath>
    <xpath expr="(//h3[hasclass('card-title')])[3]" position="replace" mode="inner">Music production</xpath>
    <xpath expr="(//p[hasclass('card-text')])[3]" position="replace" mode="inner">
        Sequence, loop and record your music with the built-in groovebox and micro-DAW.
    </xpath>
</template>

<!-- ======== PICTURE ======== -->
<template id="s_picture" inherit_id="website.s_picture" name="Zynthian s_picture">
    <xpath expr="//h2" position="replace" mode="inner">
        Hardware &amp; Software
    </xpath>
    <xpath expr="//h2/following-sibling::p" position="replace" mode="inner">
        Open hardware based on Raspberry Pi, with free software you can study, modify and share.
    </xpath>
    <xpath expr="//figcaption" position="replace" mode="inner">
        Zynthian V5
    </xpath>
</template>

<!-- ======== CALL TO ACTION ======== -->
<template id="s_call_to_action" inherit_id="website.s_call_to_action" name="Zynthian s_call_to_action">
    <xpath expr="//h3" position="replace" mode="inner">
        Get your Zynthian
    </xpath>
    <xpath expr="//h3/following-sibling::p" position="attributes">
        <attribute name="class">lead</attribute>
    </xpath>
    <xpath expr="//h3/following-sibling::p" position="replace" mode="inner">
        The latest official Zynthian V5 is available as a DIY kit.
    </xpath>
    <xpath expr="//a[hasclass('btn')]/t" position="replace" mode="inner">
        Order your KIT
    </xpath>
    <xpath expr="//a[hasclass('btn')]" position="attributes">
        <attribute name="t-att-href"/>
        <attribute name="href">/shop</attribute>
    </xpath>
</template>

<!-- ======== SHOP (/shop) ======== -->
<!-- Dark category buttons, like shop.zynthian.org -->
<template id="products_dark_nav" inherit_id="website_sale.products" name="Zynthian shop: dark navigation buttons">
    <xpath expr="//t[@t-set='navClass']" position="attributes">
        <attribute name="t-valuef">dark</attribute>
    </xpath>
</template>

<!-- No breadcrumb / search box above the grid, like shop.zynthian.org
     (in Odoo 16 the shop search box is not an optional view, so it is
     removed here instead of disabling website_sale.search) -->
<template id="products_no_breadcrumb_title" inherit_id="website_sale.products" name="Zynthian shop: no breadcrumb and search">
    <xpath expr="//div[@id='products_grid']/t[@t-call='website_sale.products_breadcrumb']" position="replace"/>
    <xpath expr="//div[hasclass('products_header')]/t[@t-call='website_sale.search']" position="replace"/>
</template>

</odoo>
